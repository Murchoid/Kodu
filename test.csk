class Person {
    var name;
    var age;
    var sex;
    
    init(name, age, sex) {
        this.name = name;
        this.age = age;
        this.sex = sex;
    }
    sayHello() 
        print "My name is " + name, " and I am a " + age + " year old " + sex;
    }
}
//this is a single line comment, its ignored
/* This is a multiline comment
It is also ignored
*/

fun main() {
    var person = Person("Michael", 22, "male);
    person.sayHello();
}
